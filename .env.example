# Chitrakatha Environment Configuration Template
# Copy this file to .env.local and populate the values.
# NOTE: Never commit sensitive credentials or connection strings to version control.

# Database Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/chitrakatha?retryWrites=true&w=majority

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (test mode only; secret values must never be exposed to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify webhook signatures. Configure the same value in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Administrator (used only by `npm run init:admin`; never commit real values)
ADMIN_EMAIL=admin@chitrakatha.art
ADMIN_NAME=Chitrakatha Administrator
# Minimum 10 characters. Use a strong, unique password.
ADMIN_PASSWORD=

# Session signing secret for admin auth cookies
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional Local Preferences
NEXT_PUBLIC_DEFAULT_LOCALE=en
